# =========================================================
# Currículo Mestre — Variáveis de Ambiente (Exemplo)
# =========================================================

# Ambiente da aplicação (development | test | production)
NODE_ENV="development"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Currículo Mestre"

# Banco de Dados PostgreSQL (Railway / Produção)
# Quando não informado em desenvolvimento local, o sistema utiliza PostgreSQL 16 embarcado (.pglite) automaticamente
DATABASE_URL="postgresql://postgres:password@localhost:5432/curriculo_mestre?schema=public"

# Segredo criptográfico para assinatura de sessões JWT HTTP-Only (mínimo 32 caracteres)
AUTH_SECRET="substitua_por_uma_chave_secreta_forte_com_pelo_menos_32_caracteres"

# E-mail do administrador inicial (recebe role ADMIN no seed/registro)
ADMIN_EMAIL="admin@curriculomestre.com.br"

# Integração Google Gemini API (Exclusivo no Backend — NUNCA usar prefixo NEXT_PUBLIC_)
GEMINI_API_KEY="sua_chave_gemini_api_aqui"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MAX_OUTPUT_TOKENS="4096"
# Preços estimados em centavos de BRL por 1 milhão de tokens (para cálculo auditável de custo de IA)
GEMINI_INPUT_PRICE_PER_1M_CENTS="90"
GEMINI_OUTPUT_PRICE_PER_1M_CENTS="350"

# Integração Gateway de Pagamentos Pix (Ex: Mercado Pago / OpenPix)
# Se MERCADOPAGO_ACCESS_TOKEN não estiver preenchido, opera em modo de homologação/teste identificado
PAYMENT_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN=""
PAYMENT_WEBHOOK_SECRET="segredo_para_validacao_hmac_do_webhook"
